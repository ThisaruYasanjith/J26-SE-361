{
  "name": "ui-prototype",
  "displayName": "ui-prototype",
  "description": "UI prototyping extension for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Architecture Governance",
      "properties": {
        "architectureGovernance.aiBackendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "FastAPI architecture AI backend base URL. Use a local service or a remote HTTPS service."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-analyzer-sidebar",
          "title": "Code Analyzer",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "code-analyzer-sidebar": [
        {
          "id": "analyzer.dashboardView",
          "name": "Analysis Modules"
        }
      ]
    },
    "commands": [
      {
        "command": "architectureGovernance.analyzeProject",
        "title": "Architecture Governance: Analyze Project Architecture"
      },
      {
        "command": "analyzer.openArchitecture",
        "title": "Open Architecture Analysis"
      },
      {
        "command": "analyzer.openCodeQuality",
        "title": "Open Code Quality"
      },
      {
        "command": "analyzer.openBehavioural",
        "title": "Open Behavioural Analysis"
      },
      {
        "command": "analyzer.openRuntime",
        "title": "Open Runtime Analysis"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:architecture": "npm run compile-tests && node --test out/test/architecture/backendClient.unit.js out/test/architecture/ruleWorkflow.unit.js out/test/architecture/architectureView.unit.js out/test/architecture/analyzerRunner.unit.js out/test/architecture/analysisWorkflow.unit.js",
    "test:analyzer-integration": "npm run compile-tests && node --test out/test/architecture/analyzerRunner.integration.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
